{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode (Vite handles the actual transpilation/bundling) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "moduleDetection": "force",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths kept flat and explicit on purpose so the architecture stays
       obvious to every future game module (Pac-Man, Snake, Bomberman, ...) */
    "baseUrl": ".",
    "paths": {
      "@scenes/*": ["src/scenes/*"],
      "@systems/*": ["src/systems/*"],
      "@entities/*": ["src/entities/*"],
      "@ui/*": ["src/ui/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
